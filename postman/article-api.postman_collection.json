{
  "info": {
    "name": "Article API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Create article",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/article/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "article"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Membuat REST API artikel dengan Go dan MySQL\",\n  \"content\": \"Go punya net/http yang sudah cukup untuk membuat REST API sederhana tanpa framework. Cukup tambahkan driver MySQL, buat tabel lewat migrasi, lalu pisahkan handler dan repository supaya mudah dites. Validasi input sebaiknya dilakukan sebelum data menyentuh database.\",\n  \"category\": \"Programming\",\n  \"status\": \"publish\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
